; Check that Post-Quantum account don't work with the disable flag
;----------------------------------------------------------------------------------------------------------
;----------------------------------------------------------------------------------------------------------
(begin-tx)
(env-exec-config ["DisableSlhDsaSignatures"])

(expect
  "q: account are not supported"
  false
  (is-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c68"))

(expect
  "q: account are not supported"
  false
  (is-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c68a4f848021ce9e63ecb26e4e2c3b01e0a"))

(expect
  "q: account are not supported"
  false
  (is-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c68a4f848021ce9e63ecb26e4e2c3b01e0aa603bfb855654ee64052e9bd38c6970a"))

(expect
  "x: account are not supported"
  false
  (is-principal "x:5PhRgNM3oePrkfAKhk9dYmjRqOhEEhbR2eyFz8HU_ew:keys-all"))


(expect
  "q: account are not supported by typeof"
  ""
  (typeof-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c68"))

(expect
  "q: account are not supported by typeof"
  ""
  (typeof-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c68a4f848021ce9e63ecb26e4e2c3b01e0a"))

(expect
  "q: account are not supported by typeof"
  ""
  (typeof-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c68a4f848021ce9e63ecb26e4e2c3b01e0aa603bfb855654ee64052e9bd38c6970a"))

(expect
  "x: account are not supported by typeof"
  ""
  (typeof-principal "x:5PhRgNM3oePrkfAKhk9dYmjRqOhEEhbR2eyFz8HU_ew:keys-all"))


(commit-tx)