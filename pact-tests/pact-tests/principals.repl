  "is-principal should be false for improper q:256s accounts"
  false
  (is-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c687a4f848021ce9e63ecb26e4e2c3b01e0aa603bfb855654ee64052e9bd38c6970a"))

(expect
  "typeof-principal should return q: for q256s accounts"
  "q:"
  (typeof-principal (create-principal (read-keyset 'ks-q256))))

(expect
  "typeof-principal should fail for q:256s accounts: improper keylength - too big"
  ""
  (typeof-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c687a4f848021ce9e63ecb26e4e2c3b01e0aa603bfb855654ee64052e9bd38c6970a"))

(expect
  "typeof-principal should fail for q:256s accounts: improper keylength - too small"
  ""
  (typeof-principal "q:584deb6f81d8efe67767309d1732019cf6ad14f9f0007cff50c730ef62521c6a4f848021ce9e63ecb26e4e2c3b01e0aa603bfb855654ee64052e9bd38c6970a"))

(commit-tx)


;----------------------------------------------------------------------------------------------------------
;----------------------------------------------------------------------------------------------------------
(begin-tx)
;; x: account validation


(expect
 "creating principal keysets with more than 1 key creates x: accounts"
 "x:HboAC_calnmHctz8ESbsu08pB0RyYalWkHqOfyPIGe4:keys-all"
 (create-principal (read-keyset 'ks-x128)))

(expect
 "validation for x: account creation validates passes"
 true
 (validate-principal
   (read-keyset 'ks-x128)
   "x:HboAC_calnmHctz8ESbsu08pB0RyYalWkHqOfyPIGe4:keys-all"
   ))

(expect
 "validation for x: account creation roundtrips with create-principal"
 true
 (validate-principal
   (read-keyset 'ks-x128)
   (create-principal (read-keyset 'ks-x128))
   ))

(expect
  "is-principal returns true for x: accounts"
  true
  (is-principal (create-principal (read-keyset 'ks-x128))))

(expect
  "is-principal should be false for improper x: accounts"
  false
  (is-principal "x:5PhRgNM3oePrkfAKhk9dYmjRqOhEEhbR2eyFz8HU_:keys-all"))

(expect
  "typeof-principal should return 'x:' for x: accounts"
  "x:"
  (typeof-principal (create-principal (read-keyset 'ks-x128))))

(expect
  "typeof-principal should fail for x accounts: improper hash length - too big"
  ""
  (typeof-principal "x:KEKrho03q2MiIqkGQBSJLbxNvj_EHfZhVDxVcye7q9Y_ewe:keys-all"))

(expect
  "typeof-principal should fail for x accounts: improper hash length - too small"
  ""
  (typeof-principal "x:KEKrho03q2MiIqkGQBSJLbxNvj_E_missing:keys-all"))

(expect
  "typeof-principal should fail for x accounts: empty predicate"
  ""
  (typeof-principal "x:KEKrho03q2MiIqkGQBSJLbxNvj_EHfZhVDxVcye7q9Y:"))

(commit-tx)

;----------------------------------------------------------------------------------------------------------
;----------------------------------------------------------------------------------------------------------
(begin-tx)
;; Mixed accounts validation => w:

(expect
 "creating principal keysets with more than 1 mixed key creates w: accounts"
 "w:LQXM1TiHKak4asnK_JZ2A1pe61bu158hdU7Td-OUnuY:keys-all"
 (create-principal (read-keyset 'ks-mixed)))

(expect
 "validation for mixed w: account creation validates passes"
 true
 (validate-principal
   (read-keyset 'ks-mixed)
   "w:LQXM1TiHKak4asnK_JZ2A1pe61bu158hdU7Td-OUnuY:keys-all"
   ))

(expect
 "validation for mixed w: account creation roundtrips with create-principal"
 true
 (validate-principal
   (read-keyset 'ks-mixed)
   (create-principal (read-keyset 'ks-mixed))
   ))

(expect
  "is-principal returns true for mixed w: accounts"
  true
  (is-principal (create-principal (read-keyset 'ks-mixed))))

(commit-tx)


;----------------------------------------------------------------------------------------------------------
