import: cabal.project

package pact-tng
  ghc-options: -Wno-deprecations
  flags: -with-pandoc-repl-rendering -with-funcall-tracing -with-native-tracing

-- WASM Compilier requires a specific -D flag
package ram
  ghc-options: -optc-D_WASI_EMULATED_MMAN
  ld-options: -lwasi-emulated-mman
  hsc2hs-options: --cc=wasm32-wasi-clang --cflag=-D_WASI_EMULATED_MMAN --lflag=-lwasi-emulated-mman

-- WASM Compilie requires No thread for Argon implementation
package crypton
  ghc-options: -optc-DARGON2_NO_THREADS

package text
  flags: -simdutf

-- We needs an up-to-date CBORG to compile with WASM
source-repository-package
  type: git
  tag: 6ef2791ca41b397a3e36c868ad3e66a0d09f19b2
  location: https://github.com/well-typed/cborg
  subdir: cborg

source-repository-package
  type: git
  tag: 6ef2791ca41b397a3e36c868ad3e66a0d09f19b2
  location: https://github.com/well-typed/cborg
  subdir: serialise

-- Patch direct-sqlite to disable dynamic link to pthread lib
source-repository-package
  type: git
  tag: ce12f7337a44f36b3686a353f40df9efa55ec4bc
  location: https://github.com/CryptoPascal31/direct-sqlite.git

source-repository-package
  type: git
  tag: adf73c1defc09a62dfdb7d08424fa58209ebfd50
  location: https://github.com/mvv/data-bword.git
  post-checkout-command: git apply ../../../patches/data-bword.diff
